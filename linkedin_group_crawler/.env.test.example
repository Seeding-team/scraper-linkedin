# Cau hinh RIENG cho Integration/E2E test co mutation (tao/sua/xoa quote
# that trong 1 database). KHONG BAO GIO copy gia tri tu .env/.env.local
# (SUPABASE_URL production/dev) vao day - script test (xem
# scratch/test_db_guard.py) se TU ABORT neu phat hien host trung voi
# production/dev hoac neu file/bien nay khong ton tai.
#
# Cach dung: copy file nay thanh `.env.test` (khong commit .env.test that,
# da co trong .gitignore) roi dien URL/key cua 1 project Supabase THAT SU
# rieng cho test (khac hoan toan seeding.db.markeeai.com).

# Cong tac an toan thu hai, doc lap voi URL - test_db_guard.py se abort neu
# thieu bien nay du TEST_SUPABASE_URL da dien dung.
APP_ENV=test

TEST_SUPABASE_URL=
TEST_SUPABASE_SERVICE_ROLE_KEY=
TEST_SUPABASE_ANON_KEY=

# Danh sach host BI CAM dung lam TEST_SUPABASE_URL - script guard so khop
# chuoi con (substring) khong phan biet hoa/thuong, chan ca bien the domain.
# Them vao day neu phat sinh host production/dev moi trong tuong lai.
FORBIDDEN_TEST_DB_HOSTS=seeding.db.markeeai.com,rtwpogvficadngtfrcci.supabase.co
