# ============================================================
# LOCAL DEV OVERRIDE — CrawlDataLinkedin
#
# Dùng để test extension trên localhost:3000 (frontend)
# kết nối tới backend local:8000 (api proxy)
#
# Extension gọi Markee service TẠI MÁY LOCAL
# qua backend proxy -> Markee service (https://auto-fb.zenithglobal.dev)
#
# CÁCH DÙNG:
#   1. Chạy backend: py -3 -m uvicorn ... (đọc .env.local)
#   2. Load extension từ thư mục __tmp_markee_extension_local
#   3. Mở localhost:3000, login với user đã có
#   4. Extension sẽ kết nối -> backend local:8000 -> Markee prod
#
# ROLLBACK (khôi phục production):
#   Xóa file này, chỉ dùng file .env gốc
# ============================================================

# Kết nối tới Markee service PRODUCTION
# Backend local đóng vai trò proxy: localhost:8000 -> auto-fb.zenithglobal.dev
MARKEE_FB_BASE_URL=https://auto-fb.zenithglobal.dev

# API Key để backend proxy gọi Markee (key từ VM seeding)
MARKEE_FB_API_KEY=0ZuQJygUBevRMOfMswmNttMGIzet8Y-w

# Key dành cho extension (đọc qua /config endpoint)
MARKEE_FB_EXTENSION_API_KEY=0ZuQJygUBevRMOfMswmNttMGIzet8Y-w

# PORT backend local
PORT=8000
HOST=0.0.0.0

# CORS cho phép frontend local
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000

# ── Seeder service (FB inbox KPI) ───────────────────────────────────────────
# Backend local gọi service_fb_seeding trên VM để đếm tin nhắn khách
SEEDER_SERVICE_URL=https://auto-fb.zenithglobal.dev
SEEDER_SERVICE_API_KEY=0ZuQJygUBevRMOfMswmNttMGIzet8Y-w

# ── Gmail OAuth cho Email Inbox Omnichannel (docker-compose.yml build arg) ─────
# Client ID là public, AN TOÀN để commit/bake vào bundle (khác Client Secret -
# secret thật chỉ nằm ở backend .env, không bao giờ đưa lên đây). Phải khớp
# GMAIL_OAUTH_CLIENT_ID bên linkedin_group_crawler/.env (xem
# thao/CRM_KNOWN_BUGS_FIXED.md mục 47). Thiếu biến này ở file .env GỐC này (nơi
# docker-compose.yml thật sự đọc để nội suy build arg) làm nút "Google Workspace/
# Gmail (OAuth)" trong modal kết nối Email Inbox bị khoá cứng (xám) dù backend đã
# cấu hình đủ - thêm vào linkedin-crawler-ui/.env là KHÔNG đủ vì NEXT_PUBLIC_* chỉ
# bake lúc build qua build arg, không phải qua env_file lúc container chạy.
NEXT_PUBLIC_GMAIL_OAUTH_CLIENT_ID=469384648646-0asgv041j3pq5vidu9rardqq6l3fpuku.apps.googleusercontent.com
