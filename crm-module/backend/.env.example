# Copy file này thành .env rồi điền giá trị thật — .env đã nằm trong .gitignore.
#
# QUAN TRỌNG: module CRM này dùng CHUNG 1 DB self-host với app seeding chính
# (prod + dev hiện cũng đang share DB này) — điền đúng SUPABASE_URL/
# SUPABASE_SERVICE_ROLE_KEY/JWT_SECRET_KEY của DB đó thì tài khoản đăng nhập
# ở app seeding cũng đăng nhập được ở module này (cùng bảng app_users).

# Supabase self-host (BẮT BUỘC — service không khởi động nổi nếu thiếu)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# JWT Auth (BẮT BUỘC — thiếu sẽ dùng default secret KHÔNG an toàn)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS — TẤT CẢ domain thật (qua NPM) mà module này trả lời, phân tách bằng
# dấu phẩy — 1 process giờ phục vụ nhiều brand cùng lúc nên phải liệt kê đủ
# domain của mọi brand, không chỉ domain của brand hiện tại.
CORS_ORIGINS=http://localhost:18090,https://crm.markee.vn,https://crm.markeeai.com,https://crm.getcloudgate.com,https://crm.securityzone.vn

HOST=0.0.0.0
PORT=8000

# AI Contract Copilot (soạn/thẩm định/tinh chỉnh hợp đồng bằng AI) — để trống
# nếu không dùng tính năng này, các nút AI sẽ chỉ báo lỗi thay vì crash service.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o

# (Tuỳ chọn) Riêng AI Contract Copilot dùng proxy OpenAI-compatible (vd proxy.markeeai.com, model cc/claude-*).
# Đặt CONTRACT_AI_BASE_URL thì mới bật chế độ proxy (stream:false, max_tokens 6000, fallback cc/*);
# không đặt thì giữ nguyên hành vi cũ dùng OPENAI_*/AI_MODEL ở trên. Không ảnh hưởng tính năng AI khác.
# CONTRACT_AI_API_KEY=
# CONTRACT_AI_BASE_URL=https://proxy.markeeai.com/v1
# CONTRACT_AI_MODEL=cc/claude-sonnet-5

# Gửi báo giá qua Telegram (nút "Gửi Telegram" ở trang Báo giá)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=
TELEGRAM_TOPIC_CHAT_ID=

# Mã xác nhận vai trò Leader (dùng ở luồng "Nâng cấp lên Leader")
LEADER_CODE=8888

# Đăng nhập Google (tuỳ chọn) — public, an toàn khi để trống nếu không dùng
GOOGLE_CLIENT_ID=

# Multi-tenant: DB self-host này dùng chung cho nhiều brand (Markee/CloudGate/
# SecurityZone...), NHƯNG giờ chỉ 1 process backend DUY NHẤT phục vụ cả 3 —
# instance thật sự dùng cho mỗi request được xác định TỰ ĐỘNG theo domain gọi
# vào (xem INSTANCE_DOMAIN_MAP ngay dưới), KHÔNG còn đọc CRM_INSTANCE cố định
# nữa. CRM_INSTANCE giờ chỉ còn là giá trị fallback khi domain gọi vào không
# khớp instance nào trong map (vd gọi thẳng bằng IP nội bộ, health-check).
CRM_INSTANCE=markee

# BẮT BUỘC — JSON object domain (không port, không "https://") -> instance.
# Middleware đọc Host header của từng request, tra bảng này để biết đang phục
# vụ brand nào — SAI hoặc THIẾU 1 domain ở đây thì domain đó sẽ rơi về
# CRM_INSTANCE (fallback) và THẤY NHẦM dữ liệu brand khác.
INSTANCE_DOMAIN_MAP={"crm.markee.vn":"markee","crm.markeeai.com":"markee","crm.getcloudgate.com":"cloudgate","crm.securityzone.vn":"securityzone"}

# BẮT BUỘC cho switcher workspace của admin — JSON object instance -> base
# URL công khai (CÓ scheme, KHÔNG có "/" cuối) để redirect admin sang khi họ
# chọn brand khác. Chọn 1 domain canonical cho mỗi instance (Markee có 2 alias
# domain — chỉ cần điền 1 cái, thường là domain chính).
WORKSPACE_DOMAINS={"markee":"https://crm.markee.vn","cloudgate":"https://crm.getcloudgate.com","SECURITYZONE":"https://crm.securityzone.vn"}

# Đồng bộ một chiều danh mục khách hàng từ workspace Markee CFO vào CRM.
# Chỉ bật cho deploy CRM_INSTANCE=markee; service-role là secret server-side.
CFO_SUPABASE_URL=
CFO_SUPABASE_SERVICE_ROLE_KEY=
CFO_WORKSPACE_ID=default
CFO_CUSTOMER_SYNC_ENABLED=0
CFO_CUSTOMER_SYNC_INTERVAL_SECONDS=30

# Inbox FB (2026-09-23) — proxy httpx sang service Markee automation NGOÀI
# (KHÔNG chạy Playwright ở đây). Không có MARKEE_FB_API_KEY thì các API /fb/*
# vẫn chạy nhưng trả 503 "not configured" thay vì crash — điền khi cần dùng
# thật. Khác hẳn CFO_*/MARKEEAI_* ở trên (đó là tích hợp campaign/CFO riêng).
MARKEE_FB_BASE_URL=https://auto-fb.zenithglobal.dev
MARKEE_FB_API_KEY=
MARKEE_FB_EXTENSION_API_KEY=

# ── Zalo Chat / Inbox Zalo Admin (2026-09-23, ghep tu zalo-module/) ──────────
# Dung chung SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY da co o tren (cung 1 self-host
# Postgres). Bucket storage RIENG cho media Zalo cua crm-module - phai tao bucket
# nay tren Supabase Storage truoc khi dung tinh nang gui/nhan anh/file qua Zalo.
ZALO_SUPABASE_STORAGE_BUCKET=crm-module-zalo-assets
ZALO_ZCA_AUTH_STORE_DIR=artifacts/zca-auth
ZALO_DEBUG_ARTIFACTS_DIR=artifacts/debug
ZALO_ASSET_RETENTION_DAYS=7
ZALO_ASSET_CLEANUP_BATCH_SIZE=200
ZALO_ZCA_OLD_MESSAGE_INTERVAL_MS=60000
ZALO_ZCA_STARTUP_SYNC_ENABLED=0
# Dat 1 de KHONG tu dong ket noi lai cac tai khoan Zalo da luu khi backend khoi dong.
DISABLE_ZCA_LISTENERS=0

# ── MSC → CRM Product Sync (migration 175) ──────────────────────────────────
# Base URL he thong MSC (chi GET /api/v1/goods; MSC la READ-ONLY).
# De trong = tat dong bo hang ngay va POST /msc-sync/run se bao loi cau hinh.
MSC_API_BASE_URL=
# Token Bearer neu MSC tuong lai them auth (hien tai /goods khong can). Khong commit token that.
MSC_API_TOKEN=
# Lich dong bo tu dong 1 lan/ngay (gio:phut). Job dung mui gio CO DINH UTC+7.
# LƯU Ý: 4 stack dùng chung 1 DB — CHỈ 1 stack nên bật scheduler; các stack
# còn lại đặt DISABLE_MSC_SYNC=1 (mặc định trống = job KHÔNG chạy nếu không
# cấu hình MSC_API_BASE_URL).
MSC_SYNC_HOUR=2
MSC_SYNC_MINUTE=30
# 1 = chay lai lan dong bo (kiem tra mapping day du, khong ghi CRM).
MSC_SYNC_DRY_RUN=
# 1 = tat scheduler dong bo MSC tren stack nay (khuyen dung cho stack KHONG
# phai nguoi chu scheduler — xem ghi chu chia se DB o tren).
DISABLE_MSC_SYNC=
# Timeout GET /api/v1/goods (giay).
MSC_SYNC_TIMEOUT_SEC=60
