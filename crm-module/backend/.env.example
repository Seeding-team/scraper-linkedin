# Copy file này thành .env rồi điền giá trị thật — .env đã nằm trong .gitignore.
#
# QUAN TRỌNG: module CRM này dùng CHUNG 1 DB self-host với app seeding chính
# (prod + dev hiện cũng đang share DB này) — điền đúng SUPABASE_URL/
# SUPABASE_SERVICE_ROLE_KEY/JWT_SECRET_KEY của DB đó thì tài khoản đăng nhập
# ở app seeding cũng đăng nhập được ở module này (cùng bảng app_users).

# Supabase self-host (BẮT BUỘC — service không khởi động nổi nếu thiếu)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# JWT Auth (BẮT BUỘC — thiếu sẽ dùng default secret KHÔNG an toàn)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS — TẤT CẢ domain thật (qua NPM) mà module này trả lời, phân tách bằng
# dấu phẩy — 1 process giờ phục vụ nhiều brand cùng lúc nên phải liệt kê đủ
# domain của mọi brand, không chỉ domain của brand hiện tại.
CORS_ORIGINS=http://localhost:18090,https://crm.markee.vn,https://crm.markeeai.com,https://crm.getcloudgate.com,https://crm.securityzone.vn

HOST=0.0.0.0
PORT=8000

# AI Contract Copilot (soạn/thẩm định/tinh chỉnh hợp đồng bằng AI) — để trống
# nếu không dùng tính năng này, các nút AI sẽ chỉ báo lỗi thay vì crash service.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o

# Gửi báo giá qua Telegram (nút "Gửi Telegram" ở trang Báo giá)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=
TELEGRAM_TOPIC_CHAT_ID=

# Mã xác nhận vai trò Leader (dùng ở luồng "Nâng cấp lên Leader")
LEADER_CODE=8888

# Đăng nhập Google (tuỳ chọn) — public, an toàn khi để trống nếu không dùng
GOOGLE_CLIENT_ID=

# Multi-tenant: DB self-host này dùng chung cho nhiều brand (Markee/CloudGate/
# SecurityZone...), NHƯNG giờ chỉ 1 process backend DUY NHẤT phục vụ cả 3 —
# instance thật sự dùng cho mỗi request được xác định TỰ ĐỘNG theo domain gọi
# vào (xem INSTANCE_DOMAIN_MAP ngay dưới), KHÔNG còn đọc CRM_INSTANCE cố định
# nữa. CRM_INSTANCE giờ chỉ còn là giá trị fallback khi domain gọi vào không
# khớp instance nào trong map (vd gọi thẳng bằng IP nội bộ, health-check).
CRM_INSTANCE=markee

# BẮT BUỘC — JSON object domain (không port, không "https://") -> instance.
# Middleware đọc Host header của từng request, tra bảng này để biết đang phục
# vụ brand nào — SAI hoặc THIẾU 1 domain ở đây thì domain đó sẽ rơi về
# CRM_INSTANCE (fallback) và THẤY NHẦM dữ liệu brand khác.
INSTANCE_DOMAIN_MAP={"crm.markee.vn":"markee","crm.markeeai.com":"markee","crm.getcloudgate.com":"cloudgate","crm.securityzone.vn":"SECURITYZONE"}

# Đồng bộ một chiều danh mục khách hàng từ workspace Markee CFO vào CRM.
# Chỉ bật cho deploy CRM_INSTANCE=markee; service-role là secret server-side.
CFO_SUPABASE_URL=
CFO_SUPABASE_SERVICE_ROLE_KEY=
CFO_WORKSPACE_ID=default
CFO_CUSTOMER_SYNC_ENABLED=0
CFO_CUSTOMER_SYNC_INTERVAL_SECONDS=30
