# File này chỉ dùng để docker-compose.yml thay biến ${...} (build-arg của
# frontend + port publish của router) — KHÁC với backend/.env (secret backend
# thật) và frontend/.env (không dùng khi build bằng Docker Compose, build-arg
# lấy từ đây). Copy thành `.env` (cùng cấp docker-compose.yml) rồi điền.

# ĐỂ TRỐNG (mặc định) — frontend gọi API qua đường dẫn TƯƠNG ĐỐI (/api/...),
# tự động đúng domain nào thì gọi domain đó (nginx đã proxy /api/ cùng domain
# với frontend). Cần thiết vì 1 build/image giờ phục vụ NHIỀU domain/brand
# (markee/cloudgate/securityzone) cùng lúc — không còn baked cứng 1 domain
# lúc build như trước. Chỉ điền giá trị khi chạy `npm run dev` trỏ sang 1
# backend khác domain (vd debug local trỏ thẳng prod).
CRM_PUBLIC_URL=

# Port publish ra ngoài của router (đổi nếu host đã dùng port này)
CRM_ROUTER_PORT=18090

NEXT_PUBLIC_LINKEDIN_CRAWLER_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
