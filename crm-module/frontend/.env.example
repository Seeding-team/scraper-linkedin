# Copy thành .env (khi build bằng Docker) hoặc .env.local (khi chạy `npm run dev`
# trực tiếp) — cả 2 đều đã nằm trong .gitignore.
#
# LƯU Ý: các biến NEXT_PUBLIC_* bị đóng cứng vào bundle LÚC BUILD (npm run
# build / docker build), không đọc lại lúc chạy container — sửa .env rồi phải
# build lại mới có tác dụng.

# Production/Docker (.env): ĐỂ TRỐNG — gọi API qua đường dẫn TƯƠNG ĐỐI
# (/api/...) để tự đúng domain/brand đang đứng (1 build giờ phục vụ nhiều
# domain markee/cloudgate/securityzone cùng lúc, không baked cứng 1 domain).
# Chạy `npm run dev` cục bộ (.env.local, KHÔNG qua nginx) thì mới cần điền
# absolute URL trỏ thẳng sang backend, vd http://localhost:8100.
NEXT_PUBLIC_LINKEDIN_CRAWLER_API_URL=
NEXT_PUBLIC_LINKEDIN_CRAWLER_API_KEY=

# Đăng nhập Google — dùng lại đúng Google Client ID của app seeding (cùng 1 dự án
# Google Cloud), vì tài khoản/DB dùng chung. Muốn nút Google hoạt động trên domain
# mới thì vào Google Cloud Console thêm domain đó vào "Authorized JavaScript origins".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
