{
  "manifest_version": 3,
  "name": "LinkedIn Group Post Crawler",
  "version": "1.5.0",
  "description": "Cào bài viết từ LinkedIn Group (kèm nội dung comment, số comment, số like, danh sách người đã like) + lấy info/comment 1 bài viết cho dashboard (DOM-scraping, dùng session đăng nhập sẵn có của trình duyệt)",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "*://*.vercel.app/*",
    "*://seeding.markeeai.com/*",
    "*://*.seeding.markeeai.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "*://*.vercel.app/*",
        "*://seeding.markeeai.com/*",
        "*://*.seeding.markeeai.com/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
