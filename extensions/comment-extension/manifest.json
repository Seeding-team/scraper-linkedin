{
  "manifest_version": 3,
  "name": "Facebook, YouTube, LinkedIn & Threads Bulk Comment Extension",
  "version": "1.7",
  "description": "Seeding Comment hàng loạt trên Facebook, YouTube, LinkedIn và Threads",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.youtube.com/*",
    "*://youtube.com/*",
    "*://*.linkedin.com/*",
    "*://*.threads.net/*",
    "*://*.threads.com/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "*://seeding.markeeai.com/*",
    "*://*.seeding.markeeai.com/*",
    "*://seeding.markee.vn/*",
    "*://*.seeding.markee.vn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Bulk Comment Extension"
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["graphql-sniffer.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": ["platforms/youtube/youtube-handler.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.linkedin.com/*"
      ],
      "js": ["platforms/linkedin/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.threads.net/*",
        "*://*.threads.com/*"
      ],
      "js": ["platforms/threads/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "*://*.vercel.app/*",
        "*://seeding.markeeai.com/*",
        "*://*.seeding.markeeai.com/*",
        "*://seeding.markee.vn/*",
        "*://*.seeding.markee.vn/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
