# Copy file này thành .env rồi điền giá trị thật — .env đã nằm trong .gitignore.
#
# QUAN TRỌNG: module CRM này dùng CHUNG 1 DB self-host với app seeding chính
# (prod + dev hiện cũng đang share DB này) — điền đúng SUPABASE_URL/
# SUPABASE_SERVICE_ROLE_KEY/JWT_SECRET_KEY của DB đó thì tài khoản đăng nhập
# ở app seeding cũng đăng nhập được ở module này (cùng bảng app_users).

# Supabase self-host (BẮT BUỘC — service không khởi động nổi nếu thiếu)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# JWT Auth (BẮT BUỘC — thiếu sẽ dùng default secret KHÔNG an toàn)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS — domain frontend của module này (qua router/nginx), phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:18092

HOST=0.0.0.0
PORT=8000

# AI Contract Copilot (soạn/thẩm định/tinh chỉnh hợp đồng bằng AI) — để trống
# nếu không dùng tính năng này, các nút AI sẽ chỉ báo lỗi thay vì crash service.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o

# Gửi báo giá qua Telegram (nút "Gửi Telegram" ở trang Báo giá)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=
TELEGRAM_TOPIC_CHAT_ID=

# Mã xác nhận vai trò Leader (dùng ở luồng "Nâng cấp lên Leader")
LEADER_CODE=8888

# Đăng nhập Google (tuỳ chọn) — public, an toàn khi để trống nếu không dùng
GOOGLE_CLIENT_ID=

# BẮT BUỘC — multi-tenant: DB self-host này dùng chung cho nhiều deploy của
# crm-module (mỗi công ty/brand 1 instance, cùng 1 DB). Giá trị này quyết định
# module đang chạy CHỈ đọc/ghi đúng dữ liệu của công ty nào — đổi SAI giá trị
# này thì module vẫn chạy bình thường (không lỗi) nhưng SẼ THẤY/GHI NHẦM dữ
# liệu công ty khác. Deploy cho Markee: "markee". Deploy cho CloudGate (hoặc
# brand khác sau này): đổi thành slug riêng của brand đó, KHÔNG trùng với bất
# kỳ instance nào đã dùng trước đây trên cùng DB này.
CRM_INSTANCE=SECURITYZONE

# BẮT BUỘC cho admin switcher + redirect non-admin nhập nhầm site — JSON
# object instance -> base URL công khai (CÓ scheme, KHÔNG có "/" cuối). PHẢI
# ĐIỀN GIỐNG HỆT NHAU trên cả 3 deploy (crm-module/crm-cloudgate/
# crm-securityzone) vì đều dùng chung 1 DB (bảng workspace_handoff_codes,
# migration 004) — thiếu hoặc sai 1 chỗ thì switcher/redirect sang brand đó
# sẽ báo lỗi "chưa cấu hình được domain".
WORKSPACE_DOMAINS={"markee":"https://crm.markee.vn","cloudgate":"https://crm.getcloudgate.com","SECURITYZONE":"https://crm.securityzone.vn"}

# API key tinh cho endpoint /api/all-platform/sync/* (he thong ngoai nhu Tech
# Support PULL khach hang da mua + contact ve theo dinh ky) - TACH BIET hoan
# toan voi JWT_SECRET_KEY/app_users, khong gan voi 1 nhan vien cu the. De
# trong = /sync/* luon tra 503 (fail-safe). Sinh 1 chuoi random du dai (vd
# `openssl rand -hex 32`), KHONG dung gia tri vi du nay o production.
CRM_SYNC_API_KEY=

# Inbox FB (2026-09-23, đồng bộ từ crm-module) — proxy httpx sang service Markee
# automation NGOÀI (KHÔNG chạy Playwright ở đây). Không có MARKEE_FB_API_KEY thì
# các API /fb/* vẫn chạy nhưng trả 503 "not configured" thay vì crash.
MARKEE_FB_BASE_URL=https://auto-fb.zenithglobal.dev
MARKEE_FB_API_KEY=
MARKEE_FB_EXTENSION_API_KEY=

# ── Zalo Chat / Inbox Zalo Admin (2026-09-23, đồng bộ từ crm-module — CHỈ core
# chat, không gồm 5 công cụ nâng cao) ───────────────────────────────────────
# Dùng chung SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY đã có ở trên. Bucket storage
# RIÊNG cho media Zalo của crm-securityzone - phải tạo bucket này trên Supabase
# Storage trước khi dùng tính năng gửi/nhận ảnh/file qua Zalo.
ZALO_SUPABASE_STORAGE_BUCKET=crm-securityzone-zalo-assets
ZALO_ZCA_AUTH_STORE_DIR=artifacts/zca-auth
ZALO_DEBUG_ARTIFACTS_DIR=artifacts/debug
ZALO_ASSET_RETENTION_DAYS=7
ZALO_ASSET_CLEANUP_BATCH_SIZE=200
ZALO_ZCA_OLD_MESSAGE_INTERVAL_MS=60000
ZALO_ZCA_STARTUP_SYNC_ENABLED=0
# Đặt 1 để KHÔNG tự động kết nối lại các tài khoản Zalo đã lưu khi backend khởi động.
DISABLE_ZCA_LISTENERS=0
