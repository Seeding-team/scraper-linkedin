# Cau hinh cho DEV LOCAL qua Docker Compose (xem docker-compose.override.yml).
#
# CACH DUNG:
#   1. cp .env.example .env   (bat buoc - docker-compose.yml doi hoi file
#      linkedin-crawler-ui/.env phai ton tai, du gia tri co the de mac dinh)
#   2. docker compose up --build   (chay tu thu muc goc repo)
#   3. Mo http://localhost:8080
#
# LUU Y QUAN TRONG: cac bien NEXT_PUBLIC_* duoc dong cung vao bundle frontend
# LUC BUILD (khong phai luc chay container) - phai sua qua build-args trong
# docker-compose.override.yml, sua rieng file .env nay KHONG co tac dung neu
# dang chay bang Docker (chi anh huong khi chay `npm run dev` truc tiep, khong
# qua Docker).
NEXT_PUBLIC_LINKEDIN_CRAWLER_API_URL=http://localhost:8080
NEXT_PUBLIC_API_FACEBOOK_BASE_URL=http://localhost:8080
NEXT_PUBLIC_LINKEDIN_CRAWLER_API_KEY=secret_api_key
# Đăng nhập bằng Google — client ID là public, an toàn để bake vào bundle.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# CRM instance/workspace cua DEPLOYMENT NAY (co dinh luc build, giong het
# CRM_INSTANCE ben backend linkedin_group_crawler/.env - xem
# app/core/config.py:321). Dung de tra domain cong khai dung workspace khi
# sinh link bao gia "Sao chep link"/"In PDF" (dang moi
# "<domain cua workspace>/baogia/{token}", thay cho "/public/quotes/{token}"
# cu dung domain CRM noi bo). Map instance -> domain nam trong
# modules/quotes/utils/publicQuoteUrl.ts - KHONG hardcode 1 domain chung cho
# ca 4 deployment (MAIN=markee, crm-module=markee, crm-cloudgate=cloudgate,
# crm-securityzone=SECURITYZONE). Gia tri phai dung DUNG casing da dung san
# khap repo: markee | cloudgate | SECURITYZONE.
NEXT_PUBLIC_CRM_INSTANCE=markee
